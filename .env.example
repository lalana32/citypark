# Local settings for docker-compose.yml.
# Copy to .env (git-ignored) and adjust if needed:  cp .env.example .env
# Every value has the same default in docker-compose.yml, so .env is optional.
# These are local-development placeholders only - never put real credentials here.

POSTGRES_DB=citypark
POSTGRES_USER=citypark
POSTGRES_PASSWORD=citypark
# Host port; change it if 5432 is already used by a local PostgreSQL install.
POSTGRES_PORT=5432

# Only for the app profile (docker compose --profile app up --build).
# Host port of the web app; change it if 8080 is already used.
APP_PORT=8080
# The administrator created on the first start (docs/auth.md#administrator-seeding).
ADMIN_EMAIL=admin@citypark.test
ADMIN_PASSWORD=Admin-Pass-2026
